PORT=3031
DRAWSY_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
DRAWSY_CONNECTOR_BACKEND_URL=http://127.0.0.1:3004
# Maximum browser round-trip for large canvas operations.
DRAWSY_CANVAS_REQUEST_TIMEOUT_MS=60000
# Remote deployments only. Must not overlap Drawsy service ports.
DRAWSY_PREVIEW_PORT_RANGE=18000-18099
# Optional when codex is not on PATH:
# DRAWSY_CODEX_BIN=/absolute/path/to/codex

# Remote execution mode (leave unset for the existing local-folder behavior):
# DRAWSY_REMOTE_WORKSPACES_ROOT=/app/session-workspaces
# DRAWSY_PREVIEW_ORIGIN_TEMPLATE=https://{token}.preview.example.com
# DRAWSY_REMOTE_SESSION_IDLE_MS=1200000
